# ═══════════════════════════════════════════════════════════
# ЛОКАЛЬНАЯ РАЗРАБОТКА (PostgreSQL через Docker)
# ═══════════════════════════════════════════════════════════
# docker compose up -d   (из корня harbor/)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=harbor_db
PGPASSWORD=admin
PGPORT=5433

PORT=5001
JWT_SECRET=local_dev_secret_change_me
CORS_ORIGINS=http://localhost:5173

# ═══════════════════════════════════════════════════════════
# PRODUCTION (Render / Railway / Fly.io + Neon / Supabase)
# ═══════════════════════════════════════════════════════════
# Закомментируй PG* выше и используй DATABASE_URL от хостинга БД:
#
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/harbor_db
# PGSSL=true
# PORT=5001
# JWT_SECRET=случайная_длинная_строка_минимум_32_символа
# CORS_ORIGINS=https://harbor-web.onrender.com,https://your-domain.com
#
# CORS_ORIGINS — URL фронтенда через запятую (обязательно на проде!)
