{
  "name": "harbor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev:all",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "images:retina": "node scripts/generate-retina-images.mjs",
    "prebuild": "npm run images:retina",
    "backend": "npm run dev --prefix src/harbor-backend",
    "backend:build": "npm run build --prefix src/harbor-backend",
    "backend:start": "npm run start --prefix src/harbor-backend",
    "dev:all": "docker-compose up -d && concurrently -n backend,web -c blue,green \"npm run backend\" \"node scripts/wait-for-backend.mjs && npm run dev\"",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker compose logs -f postgres",
    "check:deploy:backend": "node scripts/check-deploy-env.mjs backend",
    "check:deploy:frontend": "node scripts/check-deploy-env.mjs frontend"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "json-server": "^1.0.0-beta.15",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-svgr": "^5.2.0"
  }
}
