# ═══════════════════════════════════════════════════════════
# ЛОКАЛЬНАЯ РАЗРАБОТКА
# ═══════════════════════════════════════════════════════════
# Не задавай VITE_API_URL — Vite проксирует /api → localhost:5001
# VITE_API_URL=

# ═══════════════════════════════════════════════════════════
# PRODUCTION (Vercel / Netlify / Render Static)
# ═══════════════════════════════════════════════════════════
# URL задеплоенного backend БЕЗ слэша в конце:
# VITE_API_URL=https://harbor-api.onrender.com
#
# GitHub Pages (если не custom domain):
# VITE_BASE_PATH=/harbor/

# ═══════════════════════════════════════════════════════════
# YANDEX CLOUD VM (nginx + docker-compose.prod.yml)
# ═══════════════════════════════════════════════════════════
# VITE_API_URL не задавай — nginx проксирует /api → backend
# Сборка: npm run build && deploy/setup-vm.sh
